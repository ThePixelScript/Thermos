# ==============================================================================
# THERMOS Backend Production Environment Configuration
# ==============================================================================

# Application Environment ('production' or 'development')
APP_ENV=production

# Server Port (automatically assigned by Render/PaaS via $PORT)
PORT=8000

# WeatherAPI.com Key (Primary Real-time Weather Provider)
# Acquire key at https://www.weatherapi.com (1,000,000 requests/month free)
WEATHERAPI_KEY=b2f2b36c93ae426eb3c223122260809
WEATHER_API_KEY=b2f2b36c93ae426eb3c223122260809

# NASA FIRMS Map Key (Global Fire Information for Resource Management System)
# Acquire key at https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=7858186c9b6a3a6cd7a8e7e625cb5fa2

# Allowed CORS Origins (comma-separated URLs or '*' for all origins)
CORS_ORIGINS=*\n